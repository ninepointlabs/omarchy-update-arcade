#!/bin/bash
# Prints one JSON object describing the running `omarchy update`, if any:
#   {"running":false}
#   {"running":true,"window":{...}|null,"monitor":{...}|null,"logTail":"...","logAge":3}
# The window is the terminal that hosts the update: the Hyprland client whose
# pid is an ancestor of an omarchy-update process.

set -uo pipefail
PATH=/usr/bin:/bin
export PATH

log=/tmp/omarchy-update.log

# Only this user's update; another account's process of the same name is not ours.
mapfile -t update_pids < <(pgrep -u "$(id -u)" -x omarchy-update)
if (( ${#update_pids[@]} == 0 )); then
  echo '{"running":false}'
  exit 0
fi

declare -A seen=()
for pid in "${update_pids[@]}"; do
  while [[ $pid =~ ^[0-9]+$ ]] && (( pid > 1 )) && [[ -z ${seen[$pid]:-} ]]; do
    seen[$pid]=1
    pid=$(awk '/^PPid:/ { print $2 }' "/proc/$pid/status" 2>/dev/null)
  done
done
ancestors=$(printf '%s\n' "${!seen[@]}" | jq -R 'tonumber' | jq -s .)

# Window titles are private, and anything on a command line is readable by
# other users through /proc. hyprctl output therefore only ever reaches jq
# through pipes, and is cut down to the fields needed to find and cover the
# update terminal before anything else sees it.
clients() {
  hyprctl clients -j 2>/dev/null \
    | jq -c '[.[] | {address, pid, mapped, class, at, size, fullscreen, monitor, workspace: {id: .workspace.id}}]' 2>/dev/null \
    || echo '[]'
}
monitors() {
  hyprctl monitors -j 2>/dev/null \
    | jq -c '[.[] | {id, name, x, y, activeWorkspace: {id: .activeWorkspace.id}, specialWorkspace: {id: .specialWorkspace.id}}]' 2>/dev/null \
    || echo '[]'
}

log_age=-1
if [[ -f $log ]]; then
  log_age=$(( $(date +%s) - $(stat -c %Y "$log") ))
fi

jq -cn \
  --argjson ancestors "$ancestors" \
  --slurpfile clients <(clients) \
  --slurpfile monitors <(monitors) \
  --rawfile logTail <(tail -c 4096 "$log" 2>/dev/null) \
  --argjson logAge "$log_age" '
  ($clients[0] // []) as $clients
  | ($monitors[0] // []) as $monitors
  # A terminal like foot --server can own several windows; prefer the
  # presentation terminal Omarchy launches updates in.
  | ([$clients[] | select(.mapped and (.pid as $p | any($ancestors[]; . == $p)))]
    | sort_by(if .class == "org.omarchy.terminal" then 0 else 1 end)
    | first) as $win
  | ($win | if . then .monitor as $m | [$monitors[] | select(.id == $m)] | first else null end) as $mon
  | {
      running: true,
      window: ($win | if . then {address, at, size, workspace: .workspace.id, fullscreen, class} else null end),
      monitor: ($mon | if . then {
        name, x, y,
        workspace: .activeWorkspace.id,
        special: .specialWorkspace.id
      } else null end),
      logTail: $logTail,
      logAge: $logAge
    }'
